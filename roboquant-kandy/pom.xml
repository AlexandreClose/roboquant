<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.roboquant</groupId>
        <artifactId>roboquant-parent</artifactId>
        <version>3.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>roboquant-kandy</artifactId>
    <name>roboquant-kandy</name>
    <description>Kandy-based charting for roboquant using Kotlin DataFrame</description>

    <repositories>
        <repository>
            <id>kotlin-ds-maven</id>
            <name>kotlin-ds</name>
            <url>https://packages.jetbrains.team/maven/p/kds/kotlin-ds-maven</url>
        </repository>
    </repositories>

    <properties>
        <kandy.version>0.8.0</kandy.version>
        <dataframe.version>1.0.0-Beta3</dataframe.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.roboquant</groupId>
            <artifactId>roboquant</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Kotlin DataFrame -->
        <dependency>
            <groupId>org.jetbrains.kotlinx</groupId>
            <artifactId>dataframe</artifactId>
            <version>${dataframe.version}</version>
        </dependency>

        <!-- JetBrains Kandy (Lets-Plot backend) -->
        <dependency>
            <groupId>org.jetbrains.kotlinx</groupId>
            <artifactId>kandy-lets-plot</artifactId>
            <version>${kandy.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlinx</groupId>
            <artifactId>kotlin-statistics-jvm</artifactId>
            <version>0.4.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <version>${kotlin.version}</version>
                <executions>
                    <execution>
                        <id>compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>test-compile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>test-compile</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>